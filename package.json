{
  "name": "lecteur-epub",
  "version": "0.1.0",
  "private": true,
  "description": "Lecteur EPUB desktop — Encre (conception documentée dans DECISIONS.md)",
  "main": "dist/main/main.js",
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "dev": "tsc -p tsconfig.main.json && concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc -p tsconfig.main.json && vite build",
    "dist": "npm run build && electron-builder --win",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/source-serif-4": "^5.3.0",
    "better-sqlite3": "^12.0.0",
    "foliate-js": "^1.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.0",
    "electron": "^36.9.5",
    "electron-builder": "^26.15.3",
    "electron-rebuild": "^3.0.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.encre.reader",
    "productName": "Encre",
    "asar": true,
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
